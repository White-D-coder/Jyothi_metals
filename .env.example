# Copy to .env and fill in. .env is gitignored — never commit real values.

# Supabase PostgreSQL (product ingestion)
DATABASE_URL=
DIRECT_URL=
PORT=4000

# SMTP for the website Contact form and Request-a-Quote modal (nodemailer).
# Use the mailbox that is allowed to send as info@jyotimetal.co.in.
# Google Workspace / Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_USER=the mailbox address, SMTP_PASS=an App Password
#   (Google Account -> Security -> 2-Step Verification -> App passwords),
#   NOT the normal login password.
# Other providers (Zoho, Outlook, cPanel): use the SMTP host/port they list.
# On Vercel add the same keys under Project -> Settings -> Environment Variables.
SMTP_HOST=
SMTP_PORT=587
# Leave blank to auto-detect (true for 465, false for 587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Display name + address shown as the sender, e.g. "Jyoti Metal Website" <info@jyotimetal.co.in>
SMTP_FROM=
# Mailbox that receives the inquiries (defaults to info@jyotimetal.co.in).
INQUIRY_TO=

# Live metal price ticker on the home page.
# Free key (100 requests/month, no card): https://metals.dev/pricing
METALS_DEV_API_KEY=
# Cache window in minutes. 480 (8h) = ~93 calls/month, inside the free quota.
METAL_PRICES_TTL_MINUTES=480
