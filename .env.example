# Copy to .env and fill in. .env is gitignored — never commit real values.

# Supabase PostgreSQL (product ingestion)
DATABASE_URL=
DIRECT_URL=
PORT=4000

# SMTP for the website contact form (nodemailer).
# The mailbox allowed to send as info@jyotimetal.co.in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INQUIRY_TO=

# Live metal price ticker on the home page.
# Free key (100 requests/month, no card): https://metals.dev/pricing
METALS_DEV_API_KEY=
# Cache window in minutes. 480 (8h) = ~93 calls/month, inside the free quota.
METAL_PRICES_TTL_MINUTES=480
